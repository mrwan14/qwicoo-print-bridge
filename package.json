{
  "name": "qwicoo-print-bridge",
  "productName": "Qwicoo Print",
  "version": "0.1.1",
  "description": "Prints Qwicoo kitchen tickets straight to the restaurant's thermal printer.",
  "main": "dist/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Qwicoo",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "virtual-printer": "node scripts/virtual-printer.mjs"
  },
  "build": {
    "appId": "com.qwicoo.printbridge",
    "productName": "Qwicoo Print",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "Qwicoo-Print-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "Qwicoo-Print-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mrwan14",
        "repo": "qwicoo-print-bridge",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "5.6",
    "vitest": "2.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
